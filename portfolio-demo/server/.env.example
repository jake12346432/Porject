# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is gitignored — it will never be committed.

# --- Live pricing (needed for the Buy button to actually price anything) ---
# Get a free key at https://finnhub.io/register — covers US-listed stocks
# well; used first, and fast (60 requests/min).
FINNHUB_API_KEY=

# Get a free key at https://twelvedata.com/pricing (the free plan) — covers
# more international exchanges; used as a fallback for anything Finnhub
# can't price. Much stricter free-tier limit (8 requests/min, 800/day), so
# large international-heavy portfolios can take a few minutes to fully price.
TWELVEDATA_API_KEY=

# --- Password-protecting the whole app (both required together, or neither) ---
SITE_USERNAME=
SITE_PASSWORD=

# --- Optional: the "Describe what you want" AI box ---
# Get a key at https://console.anthropic.com — Settings > API Keys.
# Everything else (pricing, buy lists, combined order export) works without it.
ANTHROPIC_API_KEY=
