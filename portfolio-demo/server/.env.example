# Copy this file to ".env" (same folder) and fill in your real key.
# ".env" is gitignored — it will never be committed.
#
# Get a key at https://console.anthropic.com — Settings > API Keys.
# Only needed for the "Describe what you want" AI box; everything else
# (pricing, buy lists, combined order export) works without it.
ANTHROPIC_API_KEY=
