# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is gitignored — it will never be committed.

# --- Optional: the "Describe what you want" AI box ---
# Get a key at https://console.anthropic.com — Settings > API Keys.
# Everything else (templates, filters, charts, holdings) works without it —
# without this set, that one box shows a clear "not set up yet" error.
ANTHROPIC_API_KEY=

# --- Optional: password-protect the whole app (both required together, or neither) ---
SITE_USERNAME=
SITE_PASSWORD=
